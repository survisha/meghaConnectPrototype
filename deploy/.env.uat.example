GHCR_REGISTRY=ghcr.io
GHCR_OWNER=your-github-owner
IMAGE_TAG=sha-replace-with-immutable-commit
# bootstrap-server.sh replaces this with the existing host meghaconnect group ID.
HOST_APP_GID=replace-with-host-group-id
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=8081
MANAGEMENT_HOST_PORT=9091
PUBLIC_URL=https://meghaconnect.cloud
VERIFY_PUBLIC=true
REQUIRE_MIGRATION_APPROVAL=true
GRAFANA_ROOT_URL=https://meghaconnect.cloud/grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD_FILE=/etc/meghaconnect/secrets/grafana-admin-password
MONITORING_BEARER_TOKEN_FILE=/etc/meghaconnect/secrets/monitoring-bearer-token
MYSQL_EXPORTER_CONFIG_FILE=/etc/meghaconnect/secrets/mysql-exporter.cnf
PROMETHEUS_RETENTION=15d
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPU_LIMIT=2.0
FRONTEND_MEMORY_LIMIT=128m
FRONTEND_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512m
REDIS_CPU_LIMIT=0.5
REDIS_MAXMEMORY=384mb
REDIS_MAXMEMORY_POLICY=noeviction
PROMETHEUS_MEMORY_LIMIT=1g
PROMETHEUS_CPU_LIMIT=1.0
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_CPU_LIMIT=0.5
LOKI_MEMORY_LIMIT=512m
LOKI_CPU_LIMIT=0.5
