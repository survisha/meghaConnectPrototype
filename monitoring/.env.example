# Copy outside source control or to a protected deployment-only .env file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_WITH_SECRET_MANAGER
GRAFANA_ROOT_URL=https://your-domain.example/grafana/
GRAFANA_SERVE_FROM_SUB_PATH=true
MONITORING_BEARER_TOKEN_FILE=/opt/meghaconnect/secure/monitoring.token
MYSQL_EXPORTER_CONFIG_FILE=/opt/meghaconnect/secure/mysql-exporter.cnf
REDIS_EXPORTER_ADDR=redis://host.docker.internal:6379
REDIS_PASSWORD_FILE=/opt/meghaconnect/secure/redis.password
MEGHACONNECT_LOG_DIR=/opt/meghaconnect/logs
NGINX_LOG_DIR=/var/log/nginx
