{"uid":"meghaconnect-api","title":"MeghaConnect – API Performance","schemaVersion":39,"version":1,"refresh":"30s","templating":{"list":[{"name":"environment","type":"query","query":"label_values(http_server_requests_seconds_count,environment)"},{"name":"application","type":"query","query":"label_values(http_server_requests_seconds_count,application)"},{"name":"uri","type":"query","query":"label_values(http_server_requests_seconds_count,uri)","includeAll":true},{"name":"method","type":"query","query":"label_values(http_server_requests_seconds_count,method)","includeAll":true},{"name":"status","type":"query","query":"label_values(http_server_requests_seconds_count,status)","includeAll":true}]},"panels":[{"type":"timeseries","title":"Request Rate by Endpoint","targets":[{"expr":"sum by(uri,method)(rate(http_server_requests_seconds_count{environment=~\"$environment\",application=~\"$application\",uri=~\"$uri\",method=~\"$method\",status=~\"$status\"}[5m]))"}],"gridPos":{"x":0,"y":0,"w":12,"h":8}},{"type":"timeseries","title":"Average Response Time","targets":[{"expr":"sum by(uri)(rate(http_server_requests_seconds_sum{uri=~\"$uri\"}[5m]))/clamp_min(sum by(uri)(rate(http_server_requests_seconds_count{uri=~\"$uri\"}[5m])),0.001)"}],"gridPos":{"x":12,"y":0,"w":12,"h":8}},{"type":"heatmap","title":"Latency Heatmap","targets":[{"expr":"sum by(le)(rate(http_server_requests_seconds_bucket{uri=~\"$uri\"}[5m]))","format":"heatmap"}],"gridPos":{"x":0,"y":8,"w":24,"h":9}}]}
