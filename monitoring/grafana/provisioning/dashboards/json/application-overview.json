{
  "uid": "meghaconnect-overview",
  "title": "MeghaConnect – Application Overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": ["meghaconnect"],
  "panels": [
    {"type":"stat","title":"Application Status / Readiness","targets":[{"expr":"min(up{job=\"meghaconnect-api\"}) * min(meghaconnect_application_readiness)"}],"gridPos":{"x":0,"y":0,"w":4,"h":4}},
    {"type":"stat","title":"Application Uptime","targets":[{"expr":"process_uptime_seconds{job=\"meghaconnect-api\"}"}],"gridPos":{"x":4,"y":0,"w":4,"h":4}},
    {"type":"stat","title":"Requests per Second","targets":[{"expr":"sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m]))"}],"gridPos":{"x":8,"y":0,"w":4,"h":4}},
    {"type":"stat","title":"Average API Response Time","targets":[{"expr":"sum(rate(http_server_requests_seconds_sum{uri!~\"/actuator.*\"}[5m]))/clamp_min(sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m])),0.001)"}],"gridPos":{"x":12,"y":0,"w":4,"h":4}},
    {"type":"stat","title":"HTTP 5xx Rate","targets":[{"expr":"sum(rate(http_server_requests_seconds_count{status=~\"5..\",uri!~\"/actuator.*\"}[5m]))/clamp_min(sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m])),0.001)"}],"gridPos":{"x":16,"y":0,"w":4,"h":4}},
    {"type":"stat","title":"Active Requests","targets":[{"expr":"sum(http_server_requests_active_seconds_count)"}],"gridPos":{"x":20,"y":0,"w":4,"h":4}},
    {"type":"timeseries","title":"P50 / P90 / P95 / P99 Response Time","targets":[{"expr":"histogram_quantile(0.50,sum by(le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))","legendFormat":"P50"},{"expr":"histogram_quantile(0.90,sum by(le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))","legendFormat":"P90"},{"expr":"histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))","legendFormat":"P95"},{"expr":"histogram_quantile(0.99,sum by(le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))","legendFormat":"P99"}],"gridPos":{"x":0,"y":4,"w":12,"h":8}},
    {"type":"timeseries","title":"HTTP 2xx / 4xx / 5xx","targets":[{"expr":"sum by(outcome)(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m]))","legendFormat":"{{outcome}}"}],"gridPos":{"x":12,"y":4,"w":12,"h":8}},
    {"type":"table","title":"Top Ten Slow APIs","targets":[{"expr":"topk(10,sum by(uri,method)(rate(http_server_requests_seconds_sum{uri!~\"/actuator.*\"}[5m]))/clamp_min(sum by(uri,method)(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m])),0.001))","format":"table","instant":true}],"gridPos":{"x":0,"y":12,"w":8,"h":8}},
    {"type":"table","title":"Top Ten Most-used APIs","targets":[{"expr":"topk(10,sum by(uri,method)(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m])))","format":"table","instant":true}],"gridPos":{"x":8,"y":12,"w":8,"h":8}},
    {"type":"table","title":"Errors by Endpoint","targets":[{"expr":"sum by(uri,status)(increase(http_server_requests_seconds_count{status=~\"4..|5..\",uri!~\"/actuator.*\"}[1h]))","format":"table","instant":true}],"gridPos":{"x":16,"y":12,"w":8,"h":8}},
    {"type":"heatmap","title":"Response-time Heatmap","targets":[{"expr":"sum by(le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m]))","format":"heatmap"}],"gridPos":{"x":0,"y":20,"w":24,"h":9}}
  ]
}
