{"uid":"meghaconnect-overview","title":"MeghaConnect – Application Overview","schemaVersion":39,"version":1,"refresh":"30s","tags":["meghaconnect"],"panels":[{"type":"stat","title":"Application Status","targets":[{"expr":"up{job=\"meghaconnect-api\"}"}],"gridPos":{"x":0,"y":0,"w":6,"h":4}},{"type":"stat","title":"Application Uptime","targets":[{"expr":"process_uptime_seconds{job=\"meghaconnect-api\"}"}],"gridPos":{"x":6,"y":0,"w":6,"h":4}},{"type":"timeseries","title":"Requests per Second","targets":[{"expr":"sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m]))"}],"gridPos":{"x":0,"y":4,"w":12,"h":7}},{"type":"timeseries","title":"P50 / P90 / P95 / P99 Response Time","targets":[{"expr":"histogram_quantile(0.50,sum by(le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))","legendFormat":"P50"},{"expr":"histogram_quantile(0.90,sum by(le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))","legendFormat":"P90"},{"expr":"histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))","legendFormat":"P95"},{"expr":"histogram_quantile(0.99,sum by(le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))","legendFormat":"P99"}],"gridPos":{"x":12,"y":4,"w":12,"h":7}},{"type":"timeseries","title":"HTTP Status Distribution","targets":[{"expr":"sum by(status)(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m]))","legendFormat":"{{status}}"}],"gridPos":{"x":0,"y":11,"w":12,"h":7}},{"type":"table","title":"Top Slow APIs","targets":[{"expr":"topk(10,sum by(uri,method)(rate(http_server_requests_seconds_sum{uri!~\"/actuator.*\"}[5m]))/clamp_min(sum by(uri,method)(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m])),0.001))","format":"table","instant":true}],"gridPos":{"x":12,"y":11,"w":12,"h":7}}]}
