{
  "uid":"meghaconnect-db","title":"MeghaConnect – Database Performance","schemaVersion":39,"version":2,"refresh":"30s",
  "panels":[
    {"type":"timeseries","title":"Hikari Active / Idle / Pending / Max","targets":[{"expr":"hikaricp_connections_active","legendFormat":"active"},{"expr":"hikaricp_connections_idle","legendFormat":"idle"},{"expr":"hikaricp_connections_pending","legendFormat":"pending"},{"expr":"hikaricp_connections_max","legendFormat":"max"}],"gridPos":{"x":0,"y":0,"w":8,"h":7}},
    {"type":"timeseries","title":"Hikari Pool Utilization","targets":[{"expr":"hikaricp_connections_active/clamp_min(hikaricp_connections_max,1)"}],"gridPos":{"x":8,"y":0,"w":8,"h":7}},
    {"type":"timeseries","title":"Connection Acquire / Usage Time","targets":[{"expr":"rate(hikaricp_connections_acquire_seconds_sum[5m])/clamp_min(rate(hikaricp_connections_acquire_seconds_count[5m]),0.001)","legendFormat":"acquire"},{"expr":"rate(hikaricp_connections_usage_seconds_sum[5m])/clamp_min(rate(hikaricp_connections_usage_seconds_count[5m]),0.001)","legendFormat":"usage"}],"gridPos":{"x":16,"y":0,"w":8,"h":7}},
    {"type":"timeseries","title":"MySQL Connections / Queries / Transactions","targets":[{"expr":"mysql_global_status_threads_connected","legendFormat":"connections"},{"expr":"rate(mysql_global_status_queries[5m])","legendFormat":"queries/s"},{"expr":"rate(mysql_global_status_com_commit[5m])+rate(mysql_global_status_com_rollback[5m])","legendFormat":"transactions/s"}],"gridPos":{"x":0,"y":7,"w":8,"h":7}},
    {"type":"timeseries","title":"MySQL Slow Queries / Lock Waits","targets":[{"expr":"rate(mysql_global_status_slow_queries[5m])","legendFormat":"slow/s"},{"expr":"rate(mysql_global_status_innodb_row_lock_waits[5m])","legendFormat":"lock waits/s"}],"gridPos":{"x":8,"y":7,"w":8,"h":7}},
    {"type":"timeseries","title":"InnoDB Buffer Pool Usage","targets":[{"expr":"1-mysql_global_status_innodb_buffer_pool_pages_free/clamp_min(mysql_global_status_innodb_buffer_pool_pages_total,1)"}],"gridPos":{"x":16,"y":7,"w":8,"h":7}},
    {"type":"timeseries","title":"InnoDB Row Rates","targets":[{"expr":"rate(mysql_global_status_innodb_rows_read[5m])","legendFormat":"read"},{"expr":"rate(mysql_global_status_innodb_rows_inserted[5m])","legendFormat":"inserted"},{"expr":"rate(mysql_global_status_innodb_rows_updated[5m])","legendFormat":"updated"},{"expr":"rate(mysql_global_status_innodb_rows_deleted[5m])","legendFormat":"deleted"}],"gridPos":{"x":0,"y":14,"w":8,"h":7}},
    {"type":"timeseries","title":"Important DB Operation Duration","targets":[{"expr":"sum by(operation,result)(rate(meghaconnect_db_operation_duration_seconds_sum[5m]))/clamp_min(sum by(operation,result)(rate(meghaconnect_db_operation_duration_seconds_count[5m])),0.001)"}],"gridPos":{"x":8,"y":14,"w":8,"h":7}},
    {"type":"timeseries","title":"Important DB Operation Count","targets":[{"expr":"sum by(operation,result)(rate(meghaconnect_db_operation_total[5m]))"}],"gridPos":{"x":16,"y":14,"w":8,"h":7}}
  ]
}
