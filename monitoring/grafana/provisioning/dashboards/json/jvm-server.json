{
  "uid":"meghaconnect-jvm","title":"MeghaConnect – JVM & Server Resources","schemaVersion":39,"version":2,"refresh":"30s",
  "panels":[
    {"type":"timeseries","title":"JVM Heap Used / Max","targets":[{"expr":"sum(jvm_memory_used_bytes{area=\"heap\"})","legendFormat":"used"},{"expr":"sum(jvm_memory_max_bytes{area=\"heap\"})","legendFormat":"max"}],"gridPos":{"x":0,"y":0,"w":8,"h":7}},
    {"type":"timeseries","title":"Heap Usage Percentage","targets":[{"expr":"sum(jvm_memory_used_bytes{area=\"heap\"})/clamp_min(sum(jvm_memory_max_bytes{area=\"heap\"}),1)"}],"gridPos":{"x":8,"y":0,"w":8,"h":7}},
    {"type":"timeseries","title":"Non-heap / Metaspace / Direct Buffers","targets":[{"expr":"sum(jvm_memory_used_bytes{area=\"nonheap\"})","legendFormat":"non-heap"},{"expr":"sum(jvm_memory_used_bytes{id=~\"Metaspace.*\"})","legendFormat":"metaspace"},{"expr":"sum(jvm_buffer_memory_used_bytes)","legendFormat":"buffers"}],"gridPos":{"x":16,"y":0,"w":8,"h":7}},
    {"type":"timeseries","title":"GC Pause and Count","targets":[{"expr":"rate(jvm_gc_pause_seconds_sum[5m])","legendFormat":"pause seconds/s"},{"expr":"rate(jvm_gc_pause_seconds_count[5m])","legendFormat":"count/s"}],"gridPos":{"x":0,"y":7,"w":8,"h":7}},
    {"type":"timeseries","title":"Threads and Classes","targets":[{"expr":"jvm_threads_live_threads","legendFormat":"live"},{"expr":"jvm_threads_daemon_threads","legendFormat":"daemon"},{"expr":"jvm_threads_peak_threads","legendFormat":"peak"},{"expr":"jvm_classes_loaded_classes","legendFormat":"classes"}],"gridPos":{"x":8,"y":7,"w":8,"h":7}},
    {"type":"timeseries","title":"Process / System CPU","targets":[{"expr":"process_cpu_usage","legendFormat":"process"},{"expr":"system_cpu_usage","legendFormat":"system"}],"gridPos":{"x":16,"y":7,"w":8,"h":7}},
    {"type":"timeseries","title":"Host Memory and Swap","targets":[{"expr":"1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes","legendFormat":"memory used"},{"expr":"1-node_memory_SwapFree_bytes/clamp_min(node_memory_SwapTotal_bytes,1)","legendFormat":"swap used"}],"gridPos":{"x":0,"y":14,"w":8,"h":7}},
    {"type":"timeseries","title":"Load Average","targets":[{"expr":"node_load1","legendFormat":"1m"},{"expr":"node_load5","legendFormat":"5m"},{"expr":"node_load15","legendFormat":"15m"}],"gridPos":{"x":8,"y":14,"w":8,"h":7}},
    {"type":"timeseries","title":"Filesystem Usage","targets":[{"expr":"1-node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"}/node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}","legendFormat":"{{mountpoint}}"}],"gridPos":{"x":16,"y":14,"w":8,"h":7}},
    {"type":"timeseries","title":"Disk I/O","targets":[{"expr":"rate(node_disk_read_bytes_total[5m])","legendFormat":"read {{device}}"},{"expr":"rate(node_disk_written_bytes_total[5m])","legendFormat":"write {{device}}"}],"gridPos":{"x":0,"y":21,"w":8,"h":7}},
    {"type":"timeseries","title":"Network I/O","targets":[{"expr":"rate(node_network_receive_bytes_total{device!~\"lo\"}[5m])","legendFormat":"receive {{device}}"},{"expr":"rate(node_network_transmit_bytes_total{device!~\"lo\"}[5m])","legendFormat":"transmit {{device}}"}],"gridPos":{"x":8,"y":21,"w":8,"h":7}},
    {"type":"timeseries","title":"File Descriptors and Async Executor","targets":[{"expr":"process_files_open_files","legendFormat":"open fds"},{"expr":"executor_active{name=\"meghaconnect.executor\"}","legendFormat":"active tasks"},{"expr":"executor_queued{name=\"meghaconnect.executor\"}","legendFormat":"queued tasks"}],"gridPos":{"x":16,"y":21,"w":8,"h":7}}
  ]
}
